{
	email {$CADDY_ACME_EMAIL}
}

instigi.com, www.instigi.com {
	reverse_proxy web-app:80
}

admin.instigi.com {
	reverse_proxy admin-app:80
}

api.instigi.com {
	# Path-based routing: strip the prefix before proxying (like nginx
	# `location /auth/ { proxy_pass http://auth-service:4000/; }`).
	handle_path /auth/* {
		reverse_proxy auth-service:4000
	}

	handle_path /training/* {
		reverse_proxy training-service:4001
	}
}

pgadmin.instigi.com {
	basic_auth {
		{$PGADMIN_BASIC_AUTH_USER} {$PGADMIN_BASIC_AUTH_HASH}
	}

	reverse_proxy pgadmin:80
}
