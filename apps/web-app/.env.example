# Public origin of the API gateway (Caddy), WITHOUT any path suffix. The app
# appends `/auth` and `/training`, which Caddy strips before proxying.
#
# In local development leave this UNSET: requests are then relative to the Vite
# dev server, which proxies `/auth` -> localhost:4000 and `/training` ->
# localhost:4001 (see vite.config.ts).
#
# Example for production:
# VITE_API_URL=https://api.instigi.com
