# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=instigi

# Auth Service
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=3600

# Training Service
# Reuses POSTGRES_* (schema=training) and the shared JWT_SECRET above to
# verify auth-service-issued access tokens. No new variables required.

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@instigi.com
PGADMIN_DEFAULT_PASSWORD=change-me-in-production

# Caddy
CADDY_ACME_EMAIL=admin@instigi.com
PGADMIN_BASIC_AUTH_USER=admin
# Generate with:
# docker run --rm caddy caddy hash-password --plaintext 'your-password'
PGADMIN_BASIC_AUTH_HASH=

# Frontend build-time API gateway origin (inlined into the SPA bundles by Vite at
# `docker compose build`). The PUBLIC origin reachable from the browser, without
# any path suffix; the apps append `/auth` and `/training`, which Caddy strips.
# Changing this requires an image rebuild. Defaults (if unset) to instigi.com.
VITE_API_URL=https://api.instigi.com

# Deployment (only needed on the VPS, using docker-compose.prod.yml)
# GHCR image repository (lowercase). The deploy workflow passes this in; set it
# here only if you run docker-compose.prod.yml manually on the VPS.
GHCR_REPOSITORY=http400/instigi
# Commit SHA of the images to run. Managed automatically by the deploy workflow;
# no need to set it by hand.
APP_SHA=
